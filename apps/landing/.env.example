# Sao chép thành .env (dev) hoặc khai báo trong Vercel → Settings → Environment Variables.
# Bỏ trống → trang Thư viện ảnh hiển thị dữ liệu mẫu (gradient), không cần Google Drive.

# Webhook Google Apps Script đọc folder ảnh trên Google Drive (xem tools/apps-script/Gallery.gs)
VITE_GALLERY_SCRIPT_URL=https://script.google.com/macros/s/AKfyc.../exec

# Webhook Google Apps Script gửi lời nhắn tới banthanhniensaigon@gmail.com (xem tools/apps-script/Contact.gs)
VITE_CONTACT_SCRIPT_URL=https://script.google.com/macros/s/AKfyc.../exec


# ---------- Thông báo đẩy (Web Push) ----------
# Khoá công khai VAPID — an toàn để lộ, được nhúng vào bundle landing.
# Sinh cặp khoá bằng: npx web-push generate-vapid-keys --json
VITE_VAPID_PUBLIC_KEY=B...

# CÁC BIẾN DƯỚI ĐÂY CHỈ ĐẶT TRÊN VERCEL (Serverless Function đọc), KHÔNG có tiền tố VITE_
# và KHÔNG bao giờ commit vào git:
#   VAPID_PUBLIC_KEY           — trùng với VITE_VAPID_PUBLIC_KEY ở trên
#   VAPID_PRIVATE_KEY          — khoá bí mật, chỉ server biết
#   VAPID_SUBJECT              — mailto:banthanhniensaigon@gmail.com
#   SUPABASE_URL               — URL project Supabase
#   SUPABASE_ANON_KEY          — anon key (dùng để xác thực token người gửi)
#   SUPABASE_SERVICE_ROLE_KEY  — service role key (ghi/đọc bảng đăng ký, bỏ qua RLS)
